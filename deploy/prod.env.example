# deploy/prod.env — TEMPLATE
#
# cp deploy/prod.env.example deploy/prod.env   (gitignored, never commit)
# fill with the REAL values from the old cPanel project, then run:
#   ./deploy/make-release.sh

# --- domain layout -----------------------------------------------------------
API_DOMAIN="api.pondokhuda.com"          # subdomain serving the raw PHP api/
ADMIN_DOMAIN="admin.pondokhuda.com"      # subdomain serving the Laravel dashboard
TENANT_APP_DOMAIN="app.pondokhuda.com"   # optional PWA host; leave empty ("") to skip

# --- database: the EXISTING production database on the old account -----------
# do not create a new one — the old data stays untouched.
DB_HOST="localhost"
DB_NAME=""
DB_USER=""
DB_PASS=""

# --- shared api token ---------------------------------------------------------
# X-Api-Token accepted by gated endpoints. reuse the old project's value or a
# new random string; make-release.sh writes it into BOTH api/config-db.php and
# laravel .env so they always match.
API_TOKEN=""
