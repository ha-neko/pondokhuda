# Copy to .dev-tunnel.env after claiming the free static domain in ngrok.
# The ngrok auth token belongs in ~/.config/ngrok/ngrok.yml, never this file.

PH_TUNNEL_PROVIDER="ngrok"
PH_TUNNEL_URL="https://your-free-static-domain.ngrok-free.dev"

# Cloudflare alternative (requires an owned domain):
# PH_TUNNEL_PROVIDER="cloudflare"
# PH_TUNNEL_MODE="named"
# PH_TUNNEL_NAME="pondokhuda-dev"
# PH_TUNNEL_URL="https://dev-app.your-domain.com"
# PH_TUNNEL_CONFIG="/home/leafy/.cloudflared/config.yml"
#
# Remotely-managed Cloudflare alternative. Store the token in a separate,
# chmod-600 file and set PH_TUNNEL_MODE="token".
# PH_TUNNEL_TOKEN_FILE="/home/leafy/.cloudflared/pondokhuda-dev.token"
